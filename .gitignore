# MORDECAI .gitignore
# Keep generated files, local environments, credentials, caches, and runtime
# state out of Git. Secrets belong in a secret manager or local ignored files.

# ---------------------------------------------------------------------------
# Secrets, credentials, keys, certificates
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.env

*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.csr

*.age
*.gpg
*.asc
*.kdbx

credentials*
secrets*
secret.*
*.secret
auth.json
tokens.json

# Common cloud / infrastructure credentials
.aws/
.azure/
.gnupg/
.kube/
.docker/config.json
.terraform.d/
terraform.tfstate
terraform.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example

# SSH material
.ssh/
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
known_hosts

# ---------------------------------------------------------------------------
# Local/private configuration
# ---------------------------------------------------------------------------
config.local.*
*.local.yaml
*.local.yml
*.local.json
*.local.toml
*.local.ini
*.local.conf

private/
secrets/
credentials/

# ---------------------------------------------------------------------------
# Docker / Compose runtime and local overrides
# ---------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

.docker/
docker-data/
docker-volumes/
volumes/

# Local bind mounts / persistent runtime data
data/
runtime/
state/
storage/
uploads/
tmp/
temp/

# Do not ignore source directories with these names if explicitly tracked.
# Add project-specific exceptions later if needed.

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
coverage.xml

.venv/
venv/
env/
ENV/
.python-version

pip-wheel-metadata/
*.egg-info/
.eggs/
wheels/
dist/
build/

.ipynb_checkpoints/
.jupyter/

# Poetry / Pipenv local state
poetry.toml
Pipfile.lock.local

# ---------------------------------------------------------------------------
# Go
# ---------------------------------------------------------------------------
*.test
*.out
coverage.out
cover.out

# Go workspace files are commonly machine-local.
go.work
go.work.sum

# ---------------------------------------------------------------------------
# Rust / Cargo
# ---------------------------------------------------------------------------
target/

# Keep Cargo.lock for applications/binaries.
# Cargo.lock

# rustfmt backups
**/*.rs.bk

# ---------------------------------------------------------------------------
# Node.js / JavaScript / TypeScript
# ---------------------------------------------------------------------------
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.next/
.nuxt/
.output/
.svelte-kit/
.vite/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache

coverage/
.nyc_output/

# ---------------------------------------------------------------------------
# Java / JVM / Kotlin / Gradle / Maven
# ---------------------------------------------------------------------------
.gradle/
.mvn/timing.properties
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# Build output
bin/
out/

# ---------------------------------------------------------------------------
# C / C++ / CMake / Meson
# ---------------------------------------------------------------------------
CMakeFiles/
CMakeCache.txt
cmake-build-*/
cmake_install.cmake
compile_commands.json
Makefile.local

meson-private/
meson-logs/
meson-info/

*.o
*.obj
*.a
*.lib
*.dll
*.dylib
*.exe

# ---------------------------------------------------------------------------
# .NET
# ---------------------------------------------------------------------------
obj/
*.user
*.suo
*.userosscache
*.sln.docstates

# ---------------------------------------------------------------------------
# Terraform / OpenTofu
# ---------------------------------------------------------------------------
.terraform/
.tofu/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ---------------------------------------------------------------------------
# Ansible
# ---------------------------------------------------------------------------
*.retry
.ansible/
ansible.log

# Vault password files / local inventories
.vault_pass
vault-password*
inventory.local*
hosts.local*

# ---------------------------------------------------------------------------
# Databases / local queues / service state
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.rdb
dump.rdb

postgres-data/
redis-data/
nats-data/
minio-data/

# ---------------------------------------------------------------------------
# MORDECAI model / AI runtime artifacts
# ---------------------------------------------------------------------------
models/
checkpoints/
artifacts/
model-cache/
hf-cache/
.huggingface/
.cache/huggingface/
.cache/torch/
torch-cache/

*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
*.ggml

# ---------------------------------------------------------------------------
# Logs, traces, profiling, dumps
# ---------------------------------------------------------------------------
*.log
logs/
traces/
profiles/

*.prof
*.pprof
*.trace
*.dump
*.core
core.*

# ---------------------------------------------------------------------------
# Generic caches
# ---------------------------------------------------------------------------
.cache/
cache/
.cache-loader/
.pycache/

# ---------------------------------------------------------------------------
# IDEs / editors
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.code-workspace

*.swp
*.swo
*~
.#*
\#*\#

# ---------------------------------------------------------------------------
# OS metadata
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Generated archives / packages
# ---------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tar.xz
*.7z

# ---------------------------------------------------------------------------
# Local TLS / development PKI
# ---------------------------------------------------------------------------
certs/local/
pki/
ca-private/

# ---------------------------------------------------------------------------
# Secret scanner / security tool local state
# ---------------------------------------------------------------------------
.gitleaks-cache/
.trivy/
.grype/

# ---------------------------------------------------------------------------
# Explicitly keep safe templates and repository metadata
# ---------------------------------------------------------------------------
!.env.example
!.env.template
!docker-compose.yml
!docker-compose.yaml
!compose.yml
!compose.yaml
!Dockerfile
!Dockerfile.*
!LICENSE
!README.md
!SECURITY.md
